<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Fan Passport - Full WebApp PoC</title>
  <!-- Tailwind CSS & React Loaders -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
  <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
  <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
  <style>
    body { background-color: #0f172a; color: #f8fafc; font-family: sans-serif; }
  </style>
</head>
<body>
  <div id="root"></div>

  <script type="text/babel">
    const { useState } = React;

    function App() {
      // 메인 상태
      const [isLoggedIn, setIsLoggedIn] = useState(false);
      const [character, setCharacter] = useState(null); // 'EGEN' or 'TETO'
      const [activeTab, setActiveTab] = useState('PASSPORT'); // 'PASSPORT' | 'STORE' | 'MARKET'
      const [walletAddress, setWalletAddress] = useState("");
      
      // 잔액 및 자산 상태
      const [xp, setXp] = useState(120);
      const [fanToken, setFanToken] = useState(30); // 기본 토큰 부족하게 설정하여 충전 유도
      const [cards, setCards] = useState([]);
      const [questCompleted, setQuestCompleted] = useState(false);

      // 리셀 마켓 등록 상품 샘플
      const [marketItems, setMarketItems] = useState([
        { id: 101, title: "BTS 월드투어 서울 SSR 프리미엄 패스", seller: "0x3A2...91B", priceToken: 80, originalPrice: "150,000원", maxCapPrice: "165,000원 (상한선 적용)" },
        { id: 102, title: "에겐남 한정판 친필사인 디지털 포카", seller: "0x8F1...1C4", priceToken: 50, originalPrice: "50,000원", maxCapPrice: "55,000원 (상한선 적용)" }
      ]);

      // 로그인
      const handleLogin = (selectedChar) => {
        setCharacter(selectedChar);
        setWalletAddress("0x71C..." + Math.floor(Math.random() * 8999 + 1000));
        setIsLoggedIn(true);
      };

      // 토큰 구매 (PG 결제 시뮬레이션)
      const buyTokens = (amount, priceKrw) => {
        alert(`${priceKrw}원 결제가 완료되었습니다. ${amount} $FAN 토큰이 즉시 충전됩니다!`);
        setFanToken(prev => prev + amount);
      };

      // 퀘스트 완료
      const completeQuest = () => {
        if (questCompleted) return;
        setXp(prev => prev + 60);
        setFanToken(prev => prev + 30);
        setQuestCompleted(true);
      };

      // 토큰 소각 및 VIP 패스 합성
      const burnAndCombine = () => {
        if (fanToken < 40) {
          if (confirm("토큰이 부족합니다! 토큰 상점으로 이동하여 추가 충전하시겠습니까?")) {
            setActiveTab('STORE');
          }
          return;
        }
        setFanToken(prev => prev - 40);
        const newCard = {
          id: Date.now(),
          title: character === 'EGEN' ? "에겐남 한정판 감성 포카 & 패스" : "테토녀 VIP 직관 랭커 패스",
          grade: "SSR"
        };
        setCards([...cards, newCard]);
      };

      // 리셀 마켓 구매
      const buyFromMarket = (item) => {
        if (fanToken < item.priceToken) {
          if (confirm("토큰이 부족합니다! 토큰 상점으로 이동하시겠습니까?")) {
            setActiveTab('STORE');
          }
          return;
        }
        setFanToken(prev => prev - item.priceToken);
        setCards([...cards, { id: item.id, title: item.title, grade: "SSR" }]);
        setMarketItems(marketItems.filter(i => i.id !== item.id));
        alert("스마트 컨트랙트를 통해 소유권 이전 및 에스크로 정산이 완료되었습니다!");
      };

      return (
        <div className="max-w-md mx-auto min-h-screen bg-slate-900 flex flex-col justify-between p-4 border-x border-slate-800">
          
          {/* 헤더 */}
          <header className="pb-3 border-b border-slate-800">
            <div className="flex justify-between items-center mb-2">
              <h1 className="text-lg font-bold bg-gradient-to-r from-pink-500 via-purple-500 to-cyan-400 bg-clip-text text-transparent">
                FAN PASSPORT
              </h1>
              {isLoggedIn && (
                <div className="flex items-center gap-2">
                  <span className="text-[10px] bg-yellow-950 text-yellow-400 font-bold px-2 py-0.5 rounded-full border border-yellow-700/50">
                    {fanToken} $FAN
                  </span>
                  <span className="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full font-mono">
                    {walletAddress}
                  </span>
                </div>
              )}
            </div>

            {/* 네비게이션 탭 */}
            {isLoggedIn && (
              <nav className="flex bg-slate-950 p-1 rounded-xl border border-slate-800 text-xs font-bold">
                <button 
                  onClick={() => setActiveTab('PASSPORT')}
                  className={`flex-1 py-1.5 rounded-lg transition ${activeTab === 'PASSPORT' ? 'bg-slate-800 text-white shadow' : 'text-slate-500'}`}
                >
                  🎫 마이 패스
                </button>
                <button 
                  onClick={() => setActiveTab('STORE')}
                  className={`flex-1 py-1.5 rounded-lg transition ${activeTab === 'STORE' ? 'bg-slate-800 text-yellow-400 shadow' : 'text-slate-500'}`}
                >
                  💰 토큰 상점
                </button>
                <button 
                  onClick={() => setActiveTab('MARKET')}
                  className={`flex-1 py-1.5 rounded-lg transition ${activeTab === 'MARKET' ? 'bg-slate-800 text-cyan-400 shadow' : 'text-slate-500'}`}
                >
                  🔄 리셀 마켓
                </button>
              </nav>
            )}
          </header>

          {/* 캐릭터 미선택 시 화면 */}
          {!isLoggedIn ? (
            <main className="flex-1 flex flex-col justify-center my-6 space-y-6">
              <div className="text-center space-y-2">
                <h2 className="text-xl font-black text-white">마스코트를 선택하세요</h2>
                <p className="text-xs text-slate-400">내 덕질 성향에 맞는 마스코트와 함께 시작해보세요!</p>
              </div>

              <div className="grid grid-cols-2 gap-4">
                <div 
                  onClick={() => handleLogin('EGEN')}
                  className="bg-gradient-to-b from-pink-950/40 to-slate-900 p-4 rounded-2xl border-2 border-pink-500/40 hover:border-pink-500 cursor-pointer transition flex flex-col items-center text-center space-y-3"
                >
                  <div className="w-14 h-14 bg-pink-500/20 rounded-full flex items-center justify-center text-3xl">🐰</div>
                  <div>
                    <h3 className="text-base font-bold text-pink-200">에겐남</h3>
                    <p className="text-[10px] text-slate-400 mt-1">감성·총공·수집형</p>
                  </div>
                </div>

                <div 
                  onClick={() => handleLogin('TETO')}
                  className="bg-gradient-to-b from-cyan-950/40 to-slate-900 p-4 rounded-2xl border-2 border-cyan-500/40 hover:border-cyan-500 cursor-pointer transition flex flex-col items-center text-center space-y-3"
                >
                  <div className="w-14 h-14 bg-cyan-500/20 rounded-full flex items-center justify-center text-3xl">🐯</div>
                  <div>
                    <h3 className="text-base font-bold text-cyan-200">테토녀</h3>
                    <p className="text-[10px] text-slate-400 mt-1">경쟁·직관·랭킹형</p>
                  </div>
                </div>
              </div>
            </main>
          ) : (
            <main className="flex-1 my-4 space-y-4">
              
              {/* 탭 1: 마이 패스포트 메인 */}
              {activeTab === 'PASSPORT' && (
                <>
                  <div className={`p-4 rounded-2xl border shadow-xl transition ${
                    character === 'EGEN' ? 'bg-gradient-to-br from-pink-950/60 to-slate-900 border-pink-500/40' : 'bg-gradient-to-br from-cyan-950/60 to-slate-900 border-cyan-500/40'
                  }`}>
                    <div className="flex justify-between items-center">
                      <div className="flex items-center gap-3">
                        <div className="text-3xl">{character === 'EGEN' ? '🐰' : '🐯'}</div>
                        <div>
                          <span className={`text-[10px] font-bold ${character === 'EGEN' ? 'text-pink-400' : 'text-cyan-400'}`}>
                            {character === 'EGEN' ? '에겐남 PASSPORT' : '테토녀 PASSPORT'}
                          </span>
                          <h2 className="text-base font-bold text-white">
                            {character === 'EGEN' ? '감성 총공 리더' : '직관 승리자'}
                          </h2>
                        </div>
                      </div>
                    </div>
                    <div className="grid grid-cols-2 gap-2 mt-4">
                      <div className="bg-slate-950/60 p-2.5 rounded-xl border border-slate-800">
                        <p className="text-slate-400 text-[10px]">$XP 보유량</p>
                        <p className="text-sm font-bold text-pink-400">{xp} XP</p>
                      </div>
                      <div className="bg-slate-950/60 p-2.5 rounded-xl border border-slate-800">
                        <p className="text-slate-400 text-[10px]">$FAN 토큰</p>
                        <p className="text-sm font-bold text-yellow-400">{fanToken} $FAN</p>
                      </div>
                    </div>
                  </div>

                  {/* 퀘스트 */}
                  <div className="bg-slate-800/60 p-3.5 rounded-xl border border-slate-700">
                    <h3 className="text-xs font-bold text-slate-200 mb-2">🎯 일일 덕질 퀘스트</h3>
                    <div className="flex items-center justify-between bg-slate-900 p-2.5 rounded-lg border border-slate-800">
                      <div>
                        <p className="text-xs font-medium text-slate-300">스포티파이/멜론 총공 인증</p>
                        <p className="text-[10px] text-slate-500">+60 XP / +30 $FAN</p>
                      </div>
                      <button
                        onClick={completeQuest}
                        disabled={questCompleted}
                        className={`text-xs px-3 py-1.5 rounded-lg font-bold ${
                          questCompleted ? "bg-slate-800 text-slate-500" : "bg-pink-600 text-white hover:bg-pink-500"
                        }`}
                      >
                        {questCompleted ? "완료됨" : "인증하기"}
                      </button>
                    </div>
                  </div>

                  {/* 카드 합성 (토큰 소각) */}
                  <div className="bg-slate-800/60 p-3.5 rounded-xl border border-slate-700">
                    <div className="flex justify-between items-center mb-2">
                      <h3 className="text-xs font-bold text-slate-200">🔥 토큰 소각 & VIP 패스 합성</h3>
                      <span className="text-[10px] text-yellow-500 font-bold">40 $FAN 소각</span>
                    </div>
                    <button
                      onClick={burnAndCombine}
                      className="w-full py-2.5 bg-gradient-to-r from-amber-500 to-red-500 hover:from-amber-400 hover:to-red-400 text-white text-xs font-bold rounded-lg transition"
                    >
                      토큰 소각하고 SSR 선예매 패스 뽑기
                    </button>
                  </div>

                  {/* 보유함 */}
                  <div className="bg-slate-800/60 p-3.5 rounded-xl border border-slate-700">
                    <h3 className="text-xs font-bold text-slate-200 mb-2">🎟️ 내 스마트 보관함 ({cards.length})</h3>
                    {cards.length === 0 ? (
                      <p className="text-xs text-slate-500 text-center py-3">보유한 카드가 없습니다.</p>
                    ) : (
                      <div className="space-y-2">
                        {cards.map(card => (
                          <div key={card.id} className="bg-slate-900 p-2.5 rounded-lg border border-slate-700 flex justify-between items-center">
                            <div>
                              <span className="text-[9px] bg-red-500 text-white px-1.5 py-0.5 rounded font-black">{card.grade}</span>
                              <p className="text-xs font-bold text-slate-200 mt-1">{card.title}</p>
                            </div>
                            <span className="text-[10px] text-emerald-400 font-mono">보유 중</span>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </>
              )}

              {/* 탭 2: 토큰 상점 (추가 충전) */}
              {activeTab === 'STORE' && (
                <div className="space-y-3">
                  <div className="bg-slate-800/60 p-4 rounded-xl border border-slate-700 text-center">
                    <p className="text-xs text-slate-400">현재 보유 토큰</p>
                    <p className="text-2xl font-black text-yellow-400 mt-1">{fanToken} $FAN</p>
                  </div>

                  <h3 className="text-xs font-bold text-slate-200 pt-2">💳 $FAN 토큰 충전소 (PG 모의 결제)</h3>

                  <div className="space-y-2">
                    <div className="bg-slate-900 p-3 rounded-xl border border-slate-800 flex justify-between items-center">
                      <div>
                        <p className="text-xs font-bold text-white">50 $FAN</p>
                        <p className="text-[10px] text-slate-400">SSR 카드 합성 1회 분량</p>
                      </div>
                      <button 
                        onClick={() => buyTokens(50, "5,000")}
                        className="bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold text-xs px-3 py-1.5 rounded-lg transition"
                      >
                        ₩ 5,000 결제
                      </button>
                    </div>

                    <div className="bg-slate-900 p-3 rounded-xl border border-slate-800 flex justify-between items-center">
                      <div>
                        <p className="text-xs font-bold text-white">120 $FAN <span className="text-[9px] bg-pink-500 text-white px-1 rounded">보너스 +20</span></p>
                        <p className="text-[10px] text-slate-400">가장 인기 있는 충전팩</p>
                      </div>
                      <button 
                        onClick={() => buyTokens(120, "10,000")}
                        className="bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold text-xs px-3 py-1.5 rounded-lg transition"
                      >
                        ₩ 10,000 결제
                      </button>
                    </div>

                    <div className="bg-slate-900 p-3 rounded-xl border border-slate-800 flex justify-between items-center">
                      <div>
                        <p className="text-xs font-bold text-white">300 $FAN <span className="text-[9px] bg-purple-500 text-white px-1 rounded">보너스 +60</span></p>
                        <p className="text-[10px] text-slate-400">대량 수집가용 VIP 패키지</p>
                      </div>
                      <button 
                        onClick={() => buyTokens(300, "25,000")}
                        className="bg-yellow-500 hover:bg-yellow-400 text-slate-950 font-bold text-xs px-3 py-1.5 rounded-lg transition"
                      >
                        ₩ 25,000 결제
                      </button>
                    </div>
                  </div>
                </div>
              )}

              {/* 탭 3: 리셀 마켓 (다음 단계: 스마트 컨트랙트 안전 거래) */}
              {activeTab === 'MARKET' && (
                <div className="space-y-3">
                  <div className="bg-gradient-to-r from-purple-900/40 to-slate-900 p-3 rounded-xl border border-purple-500/30">
                    <h3 className="text-xs font-bold text-purple-300">🛡️ 암표 차단 스마트 컨트랙트 마켓</h3>
                    <p className="text-[10px] text-slate-400 mt-0.5">
                      스마트 컨트랙트로 **최대 +10% 상한선**이 고정되어 폭리 목적의 암표 거래가 원천 불가능합니다.
                    </p>
                  </div>

                  <h3 className="text-xs font-bold text-slate-200 pt-1">🛒 2차 등록 매물 ({marketItems.length})</h3>

                  {marketItems.length === 0 ? (
                    <p className="text-xs text-slate-500 text-center py-6">현재 등록된 매물이 없습니다.</p>
                  ) : (
                    <div className="space-y-2">
                      {marketItems.map(item => (
                        <div key={item.id} className="bg-slate-900 p-3 rounded-xl border border-slate-800 space-y-2">
                          <div>
                            <p className="text-xs font-bold text-white">{item.title}</p>
                            <p className="text-[10px] text-slate-500">판매자: {item.seller}</p>
                            <p className="text-[10px] text-emerald-400">{item.maxCapPrice}</p>
                          </div>
                          <div className="flex justify-between items-center pt-2 border-t border-slate-800">
                            <span className="text-xs font-bold text-yellow-400">{item.priceToken} $FAN</span>
                            <button
                              onClick={() => buyFromMarket(item)}
                              className="bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg transition"
                            >
                              안전 구매하기
                            </button>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>
              )}

            </main>
          )}

          {/* 푸터 */}
          <footer className="pt-3 border-t border-slate-800 text-center text-[10px] text-slate-500">
            Fan Passport • Full PoC App (Passport, Store, Resale Market)
          </footer>
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById('root')).render(<App />);
  </script>
</body>
</html>
